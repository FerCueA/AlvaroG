---
import Icon from "./ui/Icon.astro";

const items = [
	{ href: "#inicio", label: "Inicio", icon: "home" },
	{ href: "#servicios", label: "Servicios", icon: "sparkles" },
	{ href: "#precios", label: "Precios", icon: "tag" },
	{ href: "#reservar", label: "WhatsApp", icon: "whatsapp" },
];
---

<nav class="mobile-safe fixed inset-x-3 bottom-3 z-40 rounded-surface border border-line bg-surface/95 shadow-lg shadow-ink/10 backdrop-blur lg:hidden">
	<ul class="grid grid-cols-4 gap-1 p-1.5">
		{items.map((item) => (
			<li>
				<a
					href={item.href}
					class="flex min-h-12 flex-col items-center justify-center gap-1 rounded-control px-2 py-1 text-xs font-medium text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink"
				>
					<Icon name={item.icon} class="h-4.5 w-4.5" />
					{item.label}
				</a>
			</li>
		))}
	</ul>
</nav>
