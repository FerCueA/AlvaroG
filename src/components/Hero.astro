---
import Icon from "./ui/Icon.astro";

const whatsappLink = `https://wa.me/34634810054?text=${encodeURIComponent(
	"Hola Álvaro, me gustaría reservar una sesión. ¿Tienes disponibilidad esta semana?",
)}`;

const stats = [
	{ value: "+1.000", label: "Pacientes tratados" },
	{ value: "12 años", label: "De experiencia" },
	{ value: "A domicilio", label: "En Las Palmas" },
];
---

<section id="inicio" class="relative">
	<div class="shell grid items-center gap-12 pt-12 pb-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:pt-20 lg:pb-24">
		<div data-gsap="reveal">
			<p class="eyebrow">Osteopatía · Quiromasaje · Medicina china</p>

			<h1 class="mt-5 text-[2.75rem] leading-[1.02] text-ink sm:text-6xl">Álvaro García</h1>

			<p class="mt-5 max-w-md text-lg leading-relaxed text-ink-2">
				Terapias naturales a domicilio para aliviar el dolor y devolverle movilidad a tu cuerpo.
			</p>

			<div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
				<a
					href={whatsappLink}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary btn-lg"
				>
					<Icon name="whatsapp" class="h-5 w-5" />
					Reservar por WhatsApp
				</a>
				<a href="tel:+34634810054" class="link-arrow text-base">
					<Icon name="phone" class="h-4 w-4" />
					634 810 054
				</a>
			</div>

			<dl class="mt-14 flex flex-wrap gap-x-12 gap-y-6 border-t border-line pt-8">
				{stats.map((stat) => (
					<div>
						<dt class="text-xs uppercase tracking-[0.16em] text-ink-3">{stat.label}</dt>
						<dd class="mt-1.5 font-display text-2xl text-ink sm:text-3xl">{stat.value}</dd>
					</div>
				))}
			</dl>
		</div>

		<figure
			class="relative overflow-hidden rounded-surface"
			data-gsap="reveal"
			data-reveal-delay="80"
		>
			<img
				src="/images/hero.jpg"
				alt="Sesión de terapia manual"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="aspect-[4/5] w-full object-cover"
			/>
		</figure>
	</div>
</section>
