---
import Icon from "./ui/Icon.astro";

const whatsappLink = `https://wa.me/34634810054?text=${encodeURIComponent(
	"Hola Álvaro, me gustaría reservar una sesión. ¿Tienes disponibilidad esta semana?",
)}`;
---

<section id="reservar" class="bg-ink text-canvas">
	<div class="shell grid gap-10 py-20 lg:grid-cols-2 lg:items-end lg:gap-16 lg:py-28">
		<div data-gsap="reveal">
			<p class="text-xs font-semibold uppercase tracking-[0.18em] text-canvas/60">Reservas</p>
			<h2 class="mt-4 max-w-md text-4xl leading-[1.05] sm:text-5xl">
				¿Listo para aliviar tu dolor?
			</h2>
		</div>

		<div data-gsap="reveal" data-reveal-delay="60">
			<p class="max-w-md text-base leading-relaxed text-canvas/70">
				Reserva tu sesión en segundos y empieza un tratamiento adaptado a tu cuerpo y estilo de
				vida.
			</p>

			<div class="mt-8 flex flex-wrap items-center gap-4">
				<a
					href={whatsappLink}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary btn-lg"
				>
					<Icon name="whatsapp" class="h-5 w-5" />
					Reservar por WhatsApp
				</a>
				<a href="tel:+34634810054" class="btn btn-on-dark">
					<Icon name="phone" class="h-4 w-4" />
					634 810 054
				</a>
			</div>

			<p class="mt-5 text-sm text-canvas/60">
				Si me escribes ahora, te respondo con disponibilidad y precio sin compromiso.
			</p>
		</div>
	</div>
</section>
