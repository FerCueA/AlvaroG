---
/**
 * Section heading with a "meridian" marker: cinnabar point + label + hairline.
 * On scroll, the hairline draws in and the point appears (see the observer in
 * Layout.astro). Falls back to a static marker without JS.
 */
interface Props {
	index?: string;
	label: string;
	title: string;
	description?: string;
	class?: string;
}

const { index, label, title, description, class: className = "" } = Astro.props;
---

<header class:list={[className]} data-gsap="reveal">
	<div class="meridian flex items-center gap-3" data-meridian>
		<span
			class="meridian__dot h-1.5 w-1.5 shrink-0 rounded-full bg-cinnabar"
			aria-hidden="true"
		></span>
		<span class="eyebrow">
			{index && <span class="mr-2 text-cinnabar">{index}</span>}
			{label}
		</span>
		<span class="meridian__line h-px flex-1 bg-line" aria-hidden="true"></span>
	</div>
	<h2 class="mt-6 max-w-2xl text-3xl leading-[1.1] text-ink sm:text-4xl">{title}</h2>
	{description && <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-2">{description}</p>}
</header>

<style>
	.meridian__dot,
	.meridian__line {
		transition:
			opacity 500ms ease,
			transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	/* Only animate when JS is available, so the marker never disappears. */
	:global(html.js) .meridian__dot {
		opacity: 0;
		transform: scale(0.2);
	}

	:global(html.js) .meridian__line {
		transform: scaleX(0);
		transform-origin: left center;
		transition-delay: 140ms;
	}

	:global(html.js) .meridian.is-visible .meridian__dot {
		opacity: 1;
		transform: none;
	}

	:global(html.js) .meridian.is-visible .meridian__line {
		transform: scaleX(1);
	}
</style>
