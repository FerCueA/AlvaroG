---
/**
 * Section heading with a "meridian" marker: cinnabar point + label + hairline.
 * Replaces the generic eyebrow + border pattern.
 */
interface Props {
	index?: string;
	label: string;
	title: string;
	description?: string;
	class?: string;
}

const { index, label, title, description, class: className = "" } = Astro.props;
---

<header class:list={[className]} data-gsap="reveal">
	<div class="flex items-center gap-3">
		<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-cinnabar" aria-hidden="true"></span>
		<span class="eyebrow">
			{index && <span class="mr-2 text-cinnabar">{index}</span>}
			{label}
		</span>
		<span class="h-px flex-1 bg-line" aria-hidden="true"></span>
	</div>
	<h2 class="mt-6 max-w-2xl text-3xl leading-[1.1] text-ink sm:text-4xl">{title}</h2>
	{description && <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-2">{description}</p>}
</header>
