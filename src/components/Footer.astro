---
import Icon from "./ui/Icon.astro";

const instagram = "https://www.instagram.com/alvaro_garcia_osteopata/";
const tiktok = "https://www.tiktok.com/@osteopata.lvaro";
const whatsappLink = `https://wa.me/34634810054?text=${encodeURIComponent(
	"Hola Álvaro, me gustaría reservar una sesión. ¿Tienes disponibilidad esta semana?",
)}`;
---

<footer id="contacto" class="border-t border-line bg-surface">
	<div class="shell grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-16">
		<div>
			<p class="font-display text-2xl text-ink">Álvaro García</p>
			<p class="mt-2 text-sm text-ink-2">Osteopatía · Quiromasaje · Medicina china</p>
			<p class="mt-5 max-w-xs text-sm leading-relaxed text-ink-3">
				Terapias naturales personalizadas a domicilio en Las Palmas de Gran Canaria.
			</p>
		</div>

		<div>
			<h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-3">Contacto</h3>
			<ul class="mt-5 space-y-3 text-sm text-ink-2">
				<li class="flex items-start gap-3">
					<Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-clay" />
					<span>Las Palmas de Gran Canaria</span>
				</li>
				<li>
					<a
						href="tel:+34634810054"
						class="flex items-center gap-3 transition-colors hover:text-ink"
					>
						<Icon name="phone" class="h-4 w-4 shrink-0 text-clay" />
						<span class="font-medium">634 810 054</span>
					</a>
				</li>
				<li>
					<a
						href={whatsappLink}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 transition-colors hover:text-ink"
					>
						<Icon name="whatsapp" class="h-4 w-4 shrink-0 text-clay" />
						<span>WhatsApp</span>
					</a>
				</li>
			</ul>
		</div>

		<div>
			<h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-3">Sígueme</h3>
			<ul class="mt-5 space-y-3 text-sm text-ink-2">
				<li>
					<a
						href={instagram}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 transition-colors hover:text-ink"
					>
						<Icon name="instagram" class="h-4 w-4 shrink-0 text-clay" />
						<span>Instagram</span>
					</a>
				</li>
				<li>
					<a
						href={tiktok}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 transition-colors hover:text-ink"
					>
						<Icon name="tiktok" class="h-4 w-4 shrink-0 text-clay" />
						<span>TikTok</span>
					</a>
				</li>
			</ul>
		</div>
	</div>

	<div class="border-t border-line">
		<div class="shell flex flex-col gap-3 py-6 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between">
			<p>© 2026 Álvaro García. Todos los derechos reservados.</p>
			<a
				href="https://aleixofdezcuevas.es/"
				target="_blank"
				rel="noopener noreferrer"
				class="transition-colors hover:text-ink"
			>
				Diseño web por aleixofdezcuevas.es
			</a>
		</div>
	</div>
</footer>
