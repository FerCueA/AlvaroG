---
import Icon from "./ui/Icon.astro";

const services = [
	{
		title: "Osteopatía",
		image: "/images/osteopatia.jpg",
		description: "Técnica manual para el reequilibrio corporal",
	},
	{
		title: "Acupuntura",
		image: "/images/acupuntura.jpg",
		description: "Estimulación de puntos energéticos para restaurar el flujo del cuerpo",
	},
	{
		title: "Moxibustión",
		image: "/images/moxibustion.jpg",
		description: "Terapia de calor tradicional para aliviar dolencias",
	},
	{
		title: "Vendaje Neuromuscular",
		image: "/images/vendaje.jpg",
		description: "Soporte muscular sin limitar el movimiento",
	},
	{
		title: "Auriculopuntura",
		image: "/images/auriculopuntura.jpg",
		description: "Estimulación de puntos en la oreja para tratar diferentes dolencias",
	},
];

const wa = (title: string) =>
	`https://wa.me/34634810054?text=${encodeURIComponent(
		`Hola Álvaro, me gustaría reservar una sesión de ${title}. ¿Qué horario tienes disponible?`,
	)}`;
---

<section id="servicios" class="border-t border-line">
	<header class="shell pt-16 pb-2 lg:pt-24" data-gsap="reveal">
		<p class="eyebrow">Tratamientos</p>
		<h2 class="mt-4 max-w-2xl text-3xl leading-tight text-ink sm:text-4xl">
			Cinco enfoques, una misma idea: devolverte el bienestar
		</h2>
		<p class="mt-5 max-w-lg text-base leading-relaxed text-ink-2">
			Cada tratamiento parte de una valoración individual y se adapta a lo que tu cuerpo necesita en
			cada momento.
		</p>
	</header>

	<!-- MÓVIL: carousel horizontal deslizable -->
	<div class="lg:hidden">
		<div class="shell flex items-center justify-between pt-8 pb-4 text-xs uppercase tracking-[0.16em] text-ink-3">
			<span>Desliza</span>
			<span>{services.length} tratamientos</span>
		</div>
		<div
			data-carousel="services"
			class="hide-scrollbar flex gap-4 overflow-x-auto px-6 pb-6 pt-2 [scroll-snap-type:x_mandatory] [-webkit-overflow-scrolling:touch]"
		>
			{services.map((service, index) => (
				<article
					data-carousel-slide
					class={`carousel-slide-mobile ${index === 0 ? "is-active w-[80vw]" : "w-[74vw]"} flex-none snap-center`}
				>
					<img
						src={service.image}
						alt={service.title}
						loading="lazy"
						decoding="async"
						class="aspect-[4/3] w-full rounded-surface object-cover"
					/>
					<h3 class="mt-4 text-xl text-ink">{service.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-ink-2">{service.description}</p>
					<a
						href={wa(service.title)}
						target="_blank"
						rel="noopener noreferrer"
						class="link-arrow mt-4"
					>
						Reservar sesión
						<Icon name="arrow-right" class="icon-arrow h-4 w-4" />
					</a>
				</article>
			))}
			<div class="w-2 flex-none"></div>
		</div>
		<div class="mb-12 flex items-center justify-center gap-2">
			{services.map((service, index) => (
				<button
					type="button"
					data-carousel-dot="services"
					data-index={index}
					aria-label={`Ir a ${service.title}`}
					aria-pressed={index === 0 ? "true" : "false"}
					class={`h-1.5 rounded-full transition-all duration-200 ${index === 0 ? "w-7 bg-clay" : "w-1.5 bg-line"}`}
				/>
			))}
		</div>
	</div>

	<script>
		const servicesCarousel = document.querySelector<HTMLElement>('[data-carousel="services"]');
		const servicesSlides =
			servicesCarousel?.querySelectorAll<HTMLElement>("[data-carousel-slide]") ?? [];
		const servicesDots = document.querySelectorAll('[data-carousel-dot="services"]');

		const setServicesActive = (activeIndex: number) => {
			servicesSlides.forEach((slide, index) => {
				slide.classList.toggle("is-active", index === activeIndex);
			});

			servicesDots.forEach((dot, index) => {
				dot.classList.toggle("w-7", index === activeIndex);
				dot.classList.toggle("bg-clay", index === activeIndex);
				dot.classList.toggle("w-1.5", index !== activeIndex);
				dot.classList.toggle("bg-line", index !== activeIndex);
				dot.setAttribute("aria-pressed", index === activeIndex ? "true" : "false");
			});
		};

		const updateServicesFromScroll = () => {
			if (!servicesCarousel || servicesSlides.length === 0) return;
			const center = servicesCarousel.scrollLeft + servicesCarousel.clientWidth / 2;
			let activeIndex = 0;
			let bestDistance = Number.POSITIVE_INFINITY;

			servicesSlides.forEach((slide, index) => {
				const slideCenter = slide.offsetLeft + slide.clientWidth / 2;
				const distance = Math.abs(center - slideCenter);
				if (distance < bestDistance) {
					bestDistance = distance;
					activeIndex = index;
				}
			});

			setServicesActive(activeIndex);
		};

		servicesDots.forEach((dot) => {
			dot.addEventListener("click", () => {
				const index = Number(dot.getAttribute("data-index"));
				const target = servicesSlides[index];
				target?.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
			});
		});

		servicesCarousel?.addEventListener("scroll", updateServicesFromScroll, { passive: true });
		requestAnimationFrame(updateServicesFromScroll);
	</script>
	<!-- ESCRITORIO: layout editorial alternado -->
	<div class="hidden lg:block">
		{services.map((service, index) => {
			const isReverse = index % 2 !== 0;
			return (
				<article class="shell grid items-center gap-16 py-16 lg:grid-cols-2">
					<figure
						class={`overflow-hidden rounded-surface ${isReverse ? "lg:order-2" : ""}`}
						data-gsap="reveal"
					>
						<img
							src={service.image}
							alt={service.title}
							loading="lazy"
							decoding="async"
							class="h-120 w-full object-cover"
						/>
					</figure>
					<div
						class={`max-w-md ${isReverse ? "lg:order-1" : ""}`}
						data-gsap="reveal"
						data-reveal-delay="60"
					>
						<p class="text-xs uppercase tracking-[0.18em] text-ink-3">
							{String(index + 1).padStart(2, "0")} — Terapia
						</p>
						<h3 class="mt-4 text-3xl leading-tight text-ink xl:text-4xl">{service.title}</h3>
						<p class="mt-5 text-base leading-relaxed text-ink-2">{service.description}</p>
						<a
							href={wa(service.title)}
							target="_blank"
							rel="noopener noreferrer"
							class="link-arrow mt-6"
						>
							Reservar sesión
							<Icon name="arrow-right" class="icon-arrow h-4 w-4" />
						</a>
					</div>
				</article>
			);
		})}
	</div>
</section>
