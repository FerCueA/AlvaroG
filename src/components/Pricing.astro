---
import Icon from "./ui/Icon.astro";

const plans = [
	{
		name: "Sesión individual",
		price: "40€",
		popular: false,
		desc: "Una sesión completa para empezar tu recuperación.",
	},
	{
		name: "Bono 2 sesiones",
		price: "70€",
		popular: false,
		desc: "Ideal para trabajar un problema concreto en profundidad.",
	},
	{
		name: "Bono 3 sesiones",
		price: "105€",
		popular: true,
		desc: "El plan más elegido. Permite un abordaje completo y una recuperación real, con seguimiento entre sesiones.",
		perks: [
			"3 sesiones personalizadas",
			"Evaluación inicial incluida",
			"Seguimiento entre sesiones",
			"A domicilio en Las Palmas",
			"Ahorra 15€ respecto a sesiones sueltas",
		],
	},
	{
		name: "Bono 5 sesiones",
		price: "175€",
		popular: false,
		desc: "Para un tratamiento continuado y resultados duraderos.",
	},
];

const wa = (name: string) =>
	`https://wa.me/34634810054?text=${encodeURIComponent(
		`Hola Álvaro, me interesa el bono de ${name}. ¿Me cuentas la disponibilidad para empezar?`,
	)}`;
---

<section id="precios" class="border-t border-line bg-surface">
	<div class="shell py-16 lg:py-24">
		<header class="max-w-2xl" data-gsap="reveal">
			<p class="eyebrow">Precios</p>
			<h2 class="mt-4 text-3xl leading-tight text-ink sm:text-4xl">
				Elige tu ritmo de recuperación
			</h2>
			<p class="mt-5 text-base leading-relaxed text-ink-2">
				Precios claros, sin sorpresas. Cuantas más sesiones reserves, más profundo puede ser el
				trabajo y mejor sale cada sesión.
			</p>
		</header>

		<!-- MÓVIL: carousel horizontal -->
		<div class="mt-10 lg:hidden">
			<div
				id="pricing-carousel"
				data-carousel="pricing"
				class="hide-scrollbar flex gap-4 overflow-x-auto pb-6 pt-1 [scroll-snap-type:x_mandatory] [-webkit-overflow-scrolling:touch]"
			>
				{plans.map((plan) => (
					<article
						data-carousel-slide
						id={plan.popular ? "popular-card" : undefined}
						class={`carousel-slide-mobile ${plan.popular ? "is-active" : ""} flex w-[76vw] max-w-72 flex-none snap-start flex-col rounded-surface p-6 ${
							plan.popular ? "bg-clay text-white" : "border border-line bg-surface text-ink"
						}`}
					>
						<div class="flex items-center justify-between">
							<h3 class="text-lg leading-tight">{plan.name}</h3>
							{plan.popular && (
								<span class="text-xs font-semibold uppercase tracking-[0.14em] text-white/80">
									Popular
								</span>
							)}
						</div>
						<p class="mt-3 font-display text-4xl">{plan.price}</p>
						<p
							class={`mt-3 text-sm leading-relaxed ${plan.popular ? "text-white/80" : "text-ink-2"}`}
						>
							{plan.desc}
						</p>
						{plan.perks && (
							<ul class="mt-5 space-y-2">
								{plan.perks.map((perk) => (
									<li class="flex items-start gap-2 text-sm text-white/90">
										<Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" />
										{perk}
									</li>
								))}
							</ul>
						)}
						<a
							href={wa(plan.name)}
							target="_blank"
							rel="noopener noreferrer"
							class={`btn mt-auto ${plan.popular ? "bg-surface text-ink hover:bg-surface-2" : "btn-primary"}`}
						>
							Reservar
						</a>
					</article>
				))}
				<div class="w-2 flex-none"></div>
			</div>
			<div class="mb-2 flex items-center justify-center gap-2">
				{plans.map((plan, index) => (
					<button
						type="button"
						data-carousel-dot="pricing"
						data-index={index}
						aria-label={`Ir a ${plan.name}`}
						aria-pressed={plan.popular ? "true" : "false"}
						class={`h-1.5 rounded-full transition-all duration-200 ${plan.popular ? "w-7 bg-clay" : "w-1.5 bg-line"}`}
					/>
				))}
			</div>
		</div>

		<script>
			const carousel = document.getElementById("pricing-carousel");
			const popular = document.getElementById("popular-card");
			const pricingSlides = carousel?.querySelectorAll<HTMLElement>("[data-carousel-slide]") ?? [];
			const pricingDots = document.querySelectorAll('[data-carousel-dot="pricing"]');

			const setPricingActive = (activeIndex: number) => {
				pricingSlides.forEach((slide, index) => {
					slide.classList.toggle("is-active", index === activeIndex);
				});

				pricingDots.forEach((dot, index) => {
					dot.classList.toggle("w-7", index === activeIndex);
					dot.classList.toggle("bg-clay", index === activeIndex);
					dot.classList.toggle("w-1.5", index !== activeIndex);
					dot.classList.toggle("bg-line", index !== activeIndex);
					dot.setAttribute("aria-pressed", index === activeIndex ? "true" : "false");
				});
			};

			const updatePricingFromScroll = () => {
				if (!carousel || pricingSlides.length === 0) return;
				const center = carousel.scrollLeft + carousel.clientWidth / 2;
				let activeIndex = 0;
				let bestDistance = Number.POSITIVE_INFINITY;

				pricingSlides.forEach((slide, index) => {
					const slideCenter = slide.offsetLeft + slide.clientWidth / 2;
					const distance = Math.abs(center - slideCenter);
					if (distance < bestDistance) {
						bestDistance = distance;
						activeIndex = index;
					}
				});

				setPricingActive(activeIndex);
			};

			if (carousel && popular) {
				requestAnimationFrame(() => {
					const offset = popular.offsetLeft - (carousel.clientWidth - popular.clientWidth) / 2;
					carousel.scrollLeft = Math.max(offset, 0);
					updatePricingFromScroll();
				});
			}

			pricingDots.forEach((dot) => {
				dot.addEventListener("click", () => {
					const index = Number(dot.getAttribute("data-index"));
					const target = pricingSlides[index];
					target?.scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
				});
			});

			carousel?.addEventListener("scroll", updatePricingFromScroll, { passive: true });
			requestAnimationFrame(updatePricingFromScroll);
		</script>
		<!-- ESCRITORIO: tabla de precios -->
		<div class="mt-14 hidden border-t border-line lg:block" data-gsap="reveal">
			{plans.map((plan) => (
				<div
					class={`grid grid-cols-[1.7fr_0.5fr_auto] items-center gap-8 border-b border-line py-8 transition-colors ${
						plan.popular ? "bg-clay-50" : ""
					}`}
				>
					<div class={plan.popular ? "pl-6" : ""}>
						<div class="flex flex-wrap items-center gap-x-4 gap-y-1">
							<h3 class="text-2xl text-ink">{plan.name}</h3>
							{plan.popular && (
								<span class="text-xs font-semibold uppercase tracking-[0.16em] text-clay">
									Recomendado
								</span>
							)}
						</div>
						<p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-2">{plan.desc}</p>
						{plan.perks && (
							<ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
								{plan.perks.map((perk) => (
									<li class="flex items-center gap-2 text-sm text-ink-2">
										<Icon name="check" class="h-4 w-4 shrink-0 text-clay" />
										{perk}
									</li>
								))}
							</ul>
						)}
					</div>
					<div class="font-display text-3xl text-ink">{plan.price}</div>
					<a
						href={wa(plan.name)}
						target="_blank"
						rel="noopener noreferrer"
						class={`btn ${plan.popular ? "btn-primary" : "btn-secondary"}`}
					>
						Reservar
					</a>
				</div>
			))}
		</div>
	</div>
</section>
