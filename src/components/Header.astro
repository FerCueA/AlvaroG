---
import Icon from "./ui/Icon.astro";

const nav = [
	{ href: "#inicio", label: "Inicio" },
	{ href: "#servicios", label: "Tratamientos" },
	{ href: "#precios", label: "Precios" },
	{ href: "#contacto", label: "Contacto" },
];

const whatsappLink = `https://wa.me/34634810054?text=${encodeURIComponent(
	"Hola Álvaro, me gustaría reservar una sesión. ¿Tienes disponibilidad esta semana?",
)}`;
---

<header class="sticky top-0 z-40 hidden border-b border-line/70 bg-canvas/85 backdrop-blur lg:block">
	<div class="shell flex h-16 items-center justify-between">
		<a href="#inicio" class="flex items-baseline gap-2">
			<span class="font-display text-lg tracking-tight text-ink">Álvaro García</span>
			<span class="hidden text-xs tracking-[0.16em] text-ink-3 xl:inline">OSTEOPATÍA</span>
		</a>

		<nav aria-label="Navegación principal">
			<ul class="flex items-center gap-8 text-sm">
				{nav.map((item) => (
					<li>
						<a href={item.href} class="text-ink-2 transition-colors hover:text-ink">
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
			<Icon name="whatsapp" class="h-4 w-4" />
			Reservar
		</a>
	</div>
</header>
